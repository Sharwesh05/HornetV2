# /etc/hornet/hornet.env on the honeypot host (Phase H7): non-secret settings only. Secrets (admin key, database URL,
# NVIDIA key) are systemd credentials, see hornet.service. Check with:
#   HORNET_ENV=prod python -m scripts.dev safety    (it refuses unsafe production settings)
HORNET_ENV=prod
HORNET_RUNTIME_DRIVER=gvisor

# the decoy door: the only public port. The operators' real sshd moves to 2202 (VPN only).
HORNET_GATEWAY_ENABLED=true
HORNET_GATEWAY_HOST=0.0.0.0
HORNET_GATEWAY_PORT=22
HORNET_GATEWAY_HOST_KEY_PATH=/opt/hornet/data/gateway/ssh_host_ed25519_key
HORNET_GATEWAY_LOG_PASSWORDS=false
HORNET_GATEWAY_MAX_CONNECTIONS_PER_IP=3

# twin limits (defaults; tighten if the host is small)
HORNET_MAX_ACTIVE_SESSIONS=5
HORNET_SESSION_TTL_S=900
HORNET_IDLE_TTL_S=300

# recorded data: redacted commands only, purged automatically after 30 days
HORNET_STORE_RAW_COMMANDS=false
HORNET_RETENTION_DAYS=30
HORNET_RETENTION_AUTO=true

# the dashboard is served to investigators over the VPN, with TLS
HORNET_DASHBOARD_ORIGINS=https://hornet.vpn.internal

# discovery of the real server happens on its own host with its own allowlist; leave empty here
HORNET_DISCOVERY_ALLOWED_PROJECTS=
HORNET_BUILD_DIR=/opt/hornet/data/builds

# AI (optional): with a model, the sanitizer review must be required in prod
HORNET_AI_PROVIDER=template
HORNET_AI_SANITIZER_MODE=required
HORNET_AI_SYNTH_ENABLED=false
