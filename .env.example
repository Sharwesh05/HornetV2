# Copy to .env and fill in. Never commit .env.
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(32))"
HORNET_ADMIN_API_KEY=
HORNET_ENV=dev
HORNET_DATABASE_URL=sqlite:///./hornet_dev.db
# Compose / Postgres (management plane)
POSTGRES_PASSWORD=
# compose projects Hornet may observe (comma separated); empty = discovery disabled
HORNET_DISCOVERY_ALLOWED_PROJECTS=
# where environment builds are written
HORNET_BUILD_DIR=./data/builds
# API list pagination
HORNET_PAGE_SIZE_DEFAULT=50
HORNET_PAGE_SIZE_MAX=200

# --- Twin runtime: server-side policy, never taken from attacker input.
# HORNET_ENV=dev may only make these tighter than the values below (they are the demo ceilings); looser values fail startup.
# docker = hardened Docker (Windows/Linux, weaker); gvisor = Docker's runsc runtime (Linux only)
HORNET_RUNTIME_DRIVER=docker
HORNET_TWIN_BASE_IMAGE=hornet-twin-base:2
HORNET_TWIN_TIMEOUT_MS=5000
HORNET_TWIN_OUTPUT_LIMIT_BYTES=65536
HORNET_TWIN_MEMORY_MB=128
HORNET_TWIN_CPUS=0.5
HORNET_TWIN_PIDS=64
HORNET_TWIN_TMPFS_MB=16
HORNET_MAX_ACTIVE_SESSIONS=5
# session lifetime and idle timeout, in seconds
HORNET_SESSION_TTL_S=900
HORNET_IDLE_TTL_S=300

# --- AI via NVIDIA NIM (https://build.nvidia.com). Leave HORNET_AI_PROVIDER=template to run fully offline.
HORNET_AI_PROVIDER=template
# Put your own key here (never in code, never in chat). It is read from the environment / .env only.
NVIDIA_API_KEY=
# Run GET /v1/models with your key to see what it can use; a listed model can still answer 404 for your account.
HORNET_NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# seconds to wait for one model call
HORNET_NIM_TIMEOUT_S=90
# Reasoning models spend tokens thinking; too low a limit gives "model output was cut off"
HORNET_NIM_MAX_TOKENS=16384
# For sensitive environments run a self-hosted NIM container and point this at it (same API):
HORNET_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# AI sanitizer: required = fail the build if the model cannot review; advisory = continue; off = skip
HORNET_AI_SANITIZER_MODE=required
# AI synthesis (Phase 5A): validated AI proposals for requests the fake services cannot answer. Stored for the
# investigator only; the attacker still gets the controlled error. Needs HORNET_AI_PROVIDER=nim to call a model.
HORNET_AI_SYNTH_ENABLED=false
HORNET_AI_SYNTH_TIMEOUT_S=3
HORNET_AI_SYNTH_MAX_PER_SESSION=20
HORNET_NIM_SYNTH_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- Attacker-facing SSH gateway (Phase 4). Off by default. Binds to loopback; do not expose it from a dev machine.
HORNET_GATEWAY_ENABLED=false
HORNET_GATEWAY_HOST=127.0.0.1
HORNET_GATEWAY_PORT=2222
HORNET_GATEWAY_HOST_KEY_PATH=./data/gateway/ssh_host_ed25519_key
# version string shown in the SSH banner
HORNET_GATEWAY_SERVER_VERSION=OpenSSH_9.2p1 Debian-2+deb12u3
HORNET_GATEWAY_LOGIN_TIMEOUT_S=30
# a login succeeds on this attempt of a connection (1 to 6); the weak passwords below are accepted on the first try
HORNET_GATEWAY_ACCEPT_AFTER=3
HORNET_GATEWAY_WEAK_PASSWORDS=123456,password,admin,root,toor
# false (default): store only the attempted password's length and a short hash; true: store the text
HORNET_GATEWAY_LOG_PASSWORDS=false
HORNET_GATEWAY_MAX_CONNECTIONS_PER_IP=3

# --- Recorded attacker data (README "Command storage")
# Commands are always stored with credentials redacted. true also stores the raw text (possibly real third-party secrets).
HORNET_STORE_RAW_COMMANDS=false
# `python -m scripts.dev purge` deletes ended sessions older than this many days
HORNET_RETENTION_DAYS=30
# also purge automatically, once an hour (required when HORNET_ENV=prod)
HORNET_RETENTION_AUTO=false

# --- Admin dashboard (frontend/, `python -m scripts.dev ui`): browser origins allowed to use the API and live feed
HORNET_DASHBOARD_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
